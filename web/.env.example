# Copy to .env.local and fill in from Supabase: Project Settings > API Keys.
# Both are read on the server only and never sent to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
# The secret (service role) key. The schema has no row-level security, so all
# reads go through the server, which checks caregiver_links before returning data.
SUPABASE_SECRET_KEY=your-secret-key
