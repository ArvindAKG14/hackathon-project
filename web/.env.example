# Copy to .env.local and fill in. Everything here is read on the server only.

# Supabase: Project Settings > API Keys.
SUPABASE_URL=https://your-project-ref.supabase.co
# The secret (service role) key, NOT the anon/publishable key. RLS is enabled
# on every table with no policies (db/migrations/008), so the anon key reads
# nothing; this key bypasses RLS and the server checks caregiver_links first.
SUPABASE_SECRET_KEY=your-secret-key

# Auth0: Applications > "Senior Health Monitor" > Settings.
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
# Encrypts the session cookie. Generate with: openssl rand -hex 32
AUTH0_SECRET=64-hex-characters

# Device ingest (src/app/api/devices/*) writes raw SQL, which PostgREST cannot
# express, so it connects to Postgres directly.
# Local dev: session pooler (5432). Serverless: transaction pooler (6543).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# relaxed (default, needed for Supabase's pooler cert), verify, or off.
DATABASE_SSL=relaxed

# Public by design: these ship in the browser bundle, which is safe because
# `anon` is revoked (008) and `authenticated` can only read its own linked
# seniors (010). Needed for the Realtime subscription.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Gemini, for the plain-language weekly summary on a senior's page.
# Server-side only -- never prefix with NEXT_PUBLIC_, which would inline the
# key into the browser bundle. Free tier (1,500 req/day) covers one summary
# per senior per day many times over. Omit it and the summary simply doesn't
# render; nothing else changes.
# GEMINI_API_KEY=your-google-ai-studio-key
