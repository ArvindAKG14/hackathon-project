# Copy to .env.local and fill in. Everything here is read on the server only.

# Supabase: Project Settings > API Keys.
SUPABASE_URL=https://your-project-ref.supabase.co
# The secret (service role) key. The schema has no row-level security, so all
# reads go through the server, which checks caregiver_links before returning data.
SUPABASE_SECRET_KEY=your-secret-key

# Auth0: Applications > "Senior Health Monitor" > Settings.
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
# Encrypts the session cookie. Generate with: openssl rand -hex 32
AUTH0_SECRET=64-hex-characters

# Express backend (backend/), for live push updates over SSE. If unset the
# dashboard still refreshes itself every 3 minutes by polling.
# NOTE: EventSource cannot send headers, so the caregiver id travels in the
# query string. Fine for local dev; replace with a real token before deploying.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
