PORT=4000
# URL of the Next.js frontend, for CORS
FRONTEND_URL=http://localhost:3000
SIMULATOR_INTERVAL_MS=2000

# --- Database (optional) ---
# Without DATABASE_URL the server runs exactly as before: device syncs land in
# the in-memory store only, and nothing is persisted.
#
# Supabase: use the SESSION pooler string (Dashboard -> Connect -> Session pooler).
# The direct db.<ref>.supabase.co host is IPv6-only and will not resolve from
# most machines; the transaction pooler on 6543 cannot hold session state.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
#
# Local Postgres instead:
# DATABASE_URL=postgresql://postgres@localhost:5432/health_monitor
# DATABASE_SSL=off

# TLS verification: relaxed (default, required for Supabase's pooler cert),
# verify, or off.
# DATABASE_SSL=relaxed

# Point an in-memory senior at an existing users row, so synced data joins the
# seeded history instead of creating a new senior. s1 is "Kamala Devi";
# 1111...-1111 is Margaret Chen from db/seed.sql.
# SENIOR_UUIDS={"s1":"11111111-1111-1111-1111-111111111111"}
